@{
    var pagePath = ViewContext.RouteData.Values["page"]?.ToString();
    var isLanding = User.Identity?.IsAuthenticated != true && string.Equals(pagePath, "/Index", StringComparison.OrdinalIgnoreCase);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Shrimp</title>
    <style>@@import url('https://fonts.cdnfonts.com/css/bobloxclassic');</style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 @(isLanding ? "landing-body" : "")">
    @if (!isLanding)
    {
        <nav class="navbar navbar-expand-md navbar-light bg-light site-nav">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index" aria-label="Shrimp home"><img class="site-logo" src="~/images/shrimp-logo.png" alt="Shrimp" /></a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#siteNav"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="siteNav">
                    <ul class="navbar-nav mr-auto"><li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li><li class="nav-item"><a class="nav-link" asp-page="/Catalog">Catalog</a></li><li class="nav-item"><a class="nav-link" asp-page="/Places/Index">Places</a></li></ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown ml-md-2"><button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="userMenu" data-toggle="dropdown">Account</button><div class="dropdown-menu dropdown-menu-right" aria-labelledby="userMenu"><a class="dropdown-item" asp-page="/Account/Dashboard">Home</a><a class="dropdown-item" asp-page="/Account/Settings">Settings</a><div class="dropdown-divider"></div><form method="post" asp-page="/Account/Logout"><button class="dropdown-item" type="submit">Log Out</button></form></div></div>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm mr-2" asp-page="/Account/Login">Log In</a><a class="btn btn-primary btn-sm" asp-page="/Account/Register">Sign Up</a>
                    }
                </div>
            </div>
        </nav>
    }
    <main class="flex-grow-1">@RenderBody()</main>
    @if (!isLanding)
    {
        <footer class="site-footer py-4 mt-auto"><div class="container d-md-flex justify-content-between"><span>© 2025 TB, A olroblox revival by thugshaker.</span><span class="mt-2 mt-md-0"><a href="#">Rules</a><a href="#">Terms</a><a href="#">Privacy</a><a href="#">Help</a></span></div></footer>
    }
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
