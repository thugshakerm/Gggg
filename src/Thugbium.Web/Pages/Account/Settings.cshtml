@page "/settings"
@model Thugbium.Web.Pages.Account.SettingsModel
@{ ViewData["Title"] = "Account Info"; }
<div class="container page-wrap settings-page">
    <h1 class="h3 font-weight-bold mb-4">My Settings</h1>
    <div class="row">
        <aside class="col-md-3 mb-3"><nav class="list-group settings-navigation" aria-label="Settings navigation"><a class="list-group-item list-group-item-action active" asp-page="/Account/Settings">Account Info</a><a class="list-group-item list-group-item-action" asp-page="/Account/Privacy">Privacy</a><a class="list-group-item list-group-item-action" asp-page="/Account/Security">Security</a><a class="list-group-item list-group-item-action" asp-page="/Account/Preferences">Preferences</a></nav></aside>
        <div class="col-md-9"><section class="card dark-card"><div class="card-header"><h2 class="h5 mb-0">Account Info</h2></div><div class="card-body"><div class="settings-row"><span>Username</span><strong>@Model.SettingsUser.UserName</strong></div><div class="settings-row"><span>Joined</span><strong>@Model.SettingsUser.CreatedAt.UtcDateTime.ToString("MMMM d, yyyy")</strong></div></div></section></div>
    </div>
</div>
