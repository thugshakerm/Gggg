@page
@model Thugbium.Web.Pages.Account.SettingsModel
@{ ViewData["Title"] = "Settings"; }
<div class="container page-wrap settings-page">
    <h1 class="h3 font-weight-bold mb-4">My Settings</h1>
    <div class="row">
        <aside class="col-md-3 mb-3">
            <nav class="list-group settings-navigation" aria-label="Settings navigation">
                <a class="list-group-item list-group-item-action active" href="#account">Account Info</a>
                <a class="list-group-item list-group-item-action" href="#privacy">Privacy</a>
                <a class="list-group-item list-group-item-action" href="#security">Security</a>
                <a class="list-group-item list-group-item-action" href="#preferences">Preferences</a>
            </nav>
        </aside>
        <div class="col-md-9">
            <section id="account" class="card dark-card settings-section mb-3"><div class="card-header"><h2 class="h5 mb-0">Account Info</h2></div><div class="card-body"><div class="settings-row"><span>Username</span><strong>@Model.SettingsUser.UserName</strong></div><div class="settings-row"><span>Joined</span><strong>@Model.SettingsUser.CreatedAt.UtcDateTime.ToString("MMMM d, yyyy")</strong></div></div></section>
            <section id="privacy" class="card dark-card settings-section mb-3"><div class="card-header"><h2 class="h5 mb-0">Privacy</h2></div><div class="card-body"><p class="text-muted mb-0">Privacy controls will be added after friends, messages, and place permissions exist.</p></div></section>
            <section id="security" class="card dark-card settings-section mb-3"><div class="card-header"><h2 class="h5 mb-0">Security</h2></div><div class="card-body"><div class="settings-row"><span>Discord verification</span><strong>@(Model.SettingsUser.IsDiscordVerified ? Model.SettingsUser.DiscordUserName : "Not verified")</strong></div>@if (!Model.SettingsUser.IsDiscordVerified) { <div class="discordversection mt-3"><a class="btn-discord-verify" asp-page="/Account/Discord"><img class="discord-logo" src="~/images/discord-verify.png" alt="Discord" />Verify with Discord</a></div> } else { <p class="text-muted mb-0 mt-3">Your Discord account is linked.</p> }</div></section>
            <section id="preferences" class="card dark-card settings-section"><div class="card-header"><h2 class="h5 mb-0">Preferences</h2></div><div class="card-body"><div class="settings-row"><div><strong>Dark mode</strong><br /><span>Use the dark Shrimp site theme.</span></div><div class="custom-control custom-switch"><input type="checkbox" class="custom-control-input" id="darkModeToggle" /><label class="custom-control-label" for="darkModeToggle">Enable</label></div></div></div></section>
        </div>
    </div>
</div>
@section Scripts {
<script>
    const darkModeToggle = document.getElementById('darkModeToggle');
    if (darkModeToggle) {
        darkModeToggle.checked = document.body.classList.contains('theme-dark');
        darkModeToggle.addEventListener('change', () => {
            document.body.classList.toggle('theme-dark', darkModeToggle.checked);
            localStorage.setItem('shrimp-theme', darkModeToggle.checked ? 'dark' : 'light');
        });
    }
</script>
}
