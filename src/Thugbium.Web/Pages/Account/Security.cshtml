@page "/settings/security"
@model Thugbium.Web.Pages.Account.SecurityModel
@{ ViewData["Title"] = "Security"; }
<div class="container page-wrap settings-page">
    <h1 class="h3 font-weight-bold mb-4">My Settings</h1>
    <div class="row">
        <aside class="col-md-3 mb-3"><nav class="list-group settings-navigation" aria-label="Settings navigation"><a class="list-group-item list-group-item-action" asp-page="/Account/Settings">Account Info</a><a class="list-group-item list-group-item-action" asp-page="/Account/Privacy">Privacy</a><a class="list-group-item list-group-item-action active" asp-page="/Account/Security">Security</a><a class="list-group-item list-group-item-action" asp-page="/Account/Preferences">Preferences</a></nav></aside>
        <div class="col-md-9"><section class="card dark-card"><div class="card-header"><h2 class="h5 mb-0">Security</h2></div><div class="card-body"><div class="settings-row"><span>Discord verification</span><strong>@(Model.SettingsUser.IsDiscordVerified ? Model.SettingsUser.DiscordUserName : "Not verified")</strong></div>@if (!Model.SettingsUser.IsDiscordVerified) { <div class="discordversection mt-3"><a class="btn-discord-verify" asp-page="/Account/Discord"><img class="discord-logo" src="~/images/discord-verify.png" alt="Discord" />Verify with Discord</a></div> } else { <p class="text-muted mb-0 mt-3">Your Discord account is linked.</p> }</div></section></div>
    </div>
</div>
