@page
@model Thugbium.Web.Pages.Account.DashboardModel
@{ ViewData["Title"] = "Home"; }
<div class="container page-wrap"><h1 class="h3 font-weight-bold">Hey, @Model.UserData.UserName.</h1><p class="text-muted">This is your Thugbium home.</p><div class="row"><div class="col-md-7 mb-3"><div class="card dark-card"><div class="card-header font-weight-bold">Account</div><div class="card-body"><p>Discord: <strong>@(Model.UserData.IsDiscordVerified ? Model.UserData.DiscordUserName : "Not verified")</strong></p>@if (!Model.UserData.IsDiscordVerified) { <a class="btn btn-primary" asp-page="/Account/Discord">Verify with Discord</a> } else { <a class="btn btn-outline-light" asp-page="/Account/Settings">Account settings</a> }</div></div></div><div class="col-md-5 mb-3"><div class="card dark-card"><div class="card-header font-weight-bold">Your places</div><div class="card-body"><p class="text-muted">You have no places yet.</p><a class="btn btn-outline-light" asp-page="/Places/Index">Browse places</a></div></div></div></div></div>
