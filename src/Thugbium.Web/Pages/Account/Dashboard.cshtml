@page
@model Thugbium.Web.Pages.Account.DashboardModel
@{ ViewData["Title"] = "Home"; }
<div class="container page-wrap home-page">
    <header class="home-header">
        <div class="home-avatar-container" aria-label="Character render pending"><div class="home-avatar-empty"></div><span class="avatar-status icon-online" title="Online"></span></div>
        <div class="home-header-content"><h1>Hello, @Model.UserData.UserName!</h1></div>
    </header>
    <section class="home-section home-friends">
        <div class="home-section-header"><h2>Friends (0)</h2><a class="btn btn-outline-secondary btn-sm disabled" href="#">See All</a></div>
        <div class="dark-card home-section-content"><div class="empty-state">No friends to show yet.</div></div>
    </section>

    <section class="home-section"><div class="home-section-header"><h2>Continue Playing</h2><a class="btn btn-outline-secondary btn-sm" asp-page="/Places/Index">See All</a></div><div class="dark-card home-section-content"><div class="empty-state">You have not played any places yet.</div></div></section>
    <section class="home-section"><div class="home-section-header"><h2>Favorite Games</h2><a class="btn btn-outline-secondary btn-sm" asp-page="/Places/Index">See All</a></div><div class="dark-card home-section-content"><div class="empty-state">You have not favorited any places yet.</div></div></section>

    <section class="home-section"><div class="home-section-header"><h2>My Feed</h2></div><div class="dark-card home-section-content"><div class="input-group mb-3"><input class="form-control" placeholder="New shout" disabled /><div class="input-group-append"><button class="btn btn-primary" disabled>Submit</button></div></div><div class="empty-state">Your feed is empty.</div></div></section>
</div>
