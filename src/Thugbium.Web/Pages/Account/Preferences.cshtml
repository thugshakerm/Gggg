@page "/settings/preferences"
@model Thugbium.Web.Pages.Account.PreferencesModel
@{ ViewData["Title"] = "Preferences"; }
<div class="container page-wrap settings-page">
    <h1 class="h3 font-weight-bold mb-4">Preferences</h1>
    <div class="row">
        <aside class="col-md-3 mb-3"><nav class="list-group settings-navigation" aria-label="Settings navigation"><a class="list-group-item list-group-item-action" asp-page="/Account/Settings">Account Info</a><a class="list-group-item list-group-item-action" asp-page="/Account/Settings" asp-fragment="privacy">Privacy</a><a class="list-group-item list-group-item-action" asp-page="/Account/Settings" asp-fragment="security">Security</a><a class="list-group-item list-group-item-action active" asp-page="/Account/Preferences">Preferences</a></nav></aside>
        <div class="col-md-9"><section class="card dark-card"><div class="card-header"><h2 class="h5 mb-0">Theme</h2></div><div class="card-body"><div class="settings-row"><div><strong>Dark mode</strong><br /><span>Use the dark Shrimp site theme.</span></div><div class="custom-control custom-switch"><input type="checkbox" class="custom-control-input" id="darkModeToggle" /><label class="custom-control-label" for="darkModeToggle">Enable</label></div></div></div></section></div>
    </div>
</div>
@section Scripts {
<script>
    const darkModeToggle = document.getElementById('darkModeToggle');
    if (darkModeToggle) {
        darkModeToggle.checked = document.body.classList.contains('theme-dark');
        darkModeToggle.addEventListener('change', () => {
            document.body.classList.toggle('theme-dark', darkModeToggle.checked);
            localStorage.setItem('shrimp-theme', darkModeToggle.checked ? 'dark' : 'light');
        });
    }
</script>
}
