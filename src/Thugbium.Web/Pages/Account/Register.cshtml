@page
@model Thugbium.Web.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Create Account"; }
<div class="container page-wrap"><div class="row justify-content-center"><div class="col-lg-9"><div class="card dark-card"><div class="card-header d-sm-flex justify-content-between align-items-center"><div><h1 class="h3 font-weight-bold mb-1">Create an account</h1><p class="text-muted mb-0">Pick a username, make a password, then link Discord.</p></div><div class="discordversection mt-3 mt-sm-0"><a class="btn-discord-verify" href="#discord">Verify with Discord</a></div></div><div class="card-body p-4"><form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row"><div class="col-md-7"><div class="form-group"><label asp-for="Input.UserName" class="font-weight-bold">Username</label><input asp-for="Input.UserName" class="form-control" autocomplete="username" /><small class="form-text">3–20 characters. Letters, numbers, and underscores only.</small></div><div class="form-group"><label asp-for="Input.Password" class="font-weight-bold">Password</label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" /><small class="form-text">Use at least 8 characters. Do not reuse an old password.</small></div><div class="form-group"><label asp-for="Input.ConfirmPassword" class="font-weight-bold">Confirm password</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /></div><div class="form-group form-check"><input asp-for="Input.AcceptTerms" class="form-check-input" /><label asp-for="Input.AcceptTerms" class="form-check-label">I agree to the <a href="#">Terms of Use</a> and <a href="#">Community Rules</a>.</label></div><button class="btn btn-primary px-4" type="submit">Create Account</button></div><div class="col-md-5 mt-4 mt-md-0"><aside class="side-note"><h2 class="h6 font-weight-bold text-light">Before you sign up</h2><p>Thugbium is a 2017 revival project. Keep your account secure and be decent to other players.</p><p class="mb-0">Discord verification will be used instead of email verification. The button above is a preview until the bot is ready.</p></aside></div></div></form></div></div></div></div></div>
