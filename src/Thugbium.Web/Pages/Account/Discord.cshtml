@page
@model Thugbium.Web.Pages.Account.DiscordModel
@{ ViewData["Title"] = "Discord Verification"; }
<div class="container page-wrap"><div class="card dark-card"><div class="card-header"><h1 class="h3 font-weight-bold mb-1">Discord verification</h1><p class="text-muted mb-0">Link your Discord account to finish verification.</p></div><div class="card-body p-4">@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-warning">@Model.Message</div> }<div class="discordversection"><a class="btn-discord-verify" asp-page-handler="Start">Verify with Discord</a></div><p class="text-muted small mt-3 mb-0">This uses Discord OAuth with the <code>identify</code> scope only. It does not need access to your servers, messages, or friends list.</p></div></div></div>
