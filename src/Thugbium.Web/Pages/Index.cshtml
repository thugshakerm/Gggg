@page
@model Thugbium.Web.Pages.IndexModel
@{ ViewData["Title"] = "Main"; }
<div class="shrimp-landing">
    <section class="shrimp-intro"><div class="shrimp-brand"><img src="~/images/shrimp-logo.png" alt="Shrimp logo" /></div></section>
    <section class="shrimp-auth-card" aria-label="Account access">
        <h2>SIGN UP OR LOGIN AND START HAVING FUN!</h2>
        <div class="shrimp-tabs"><button type="button" class="@(Model.ActiveTab == "register" ? "active" : "")" data-auth-tab="register">Register</button><button type="button" class="@(Model.ActiveTab == "login" ? "active" : "")" data-auth-tab="login">Login</button></div>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="landing-error">@Model.ErrorMessage</div> }
        <form id="register-panel" method="post" asp-page-handler="Register" class="@(Model.ActiveTab == "register" ? "" : "d-none")">
            <div asp-validation-summary="ModelOnly" class="landing-error"></div>
            <div class="form-group"><label asp-for="Registration.UserName">Username</label><input asp-for="Registration.UserName" class="form-control" autocomplete="username" /></div>
            <div class="form-group"><label asp-for="Registration.Password">Password</label><input asp-for="Registration.Password" class="form-control" autocomplete="new-password" /></div>
            <div class="form-group"><label asp-for="Registration.ConfirmPassword">Confirm Password</label><input asp-for="Registration.ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
            <div class="form-group form-check"><input asp-for="Registration.AcceptTerms" class="form-check-input" /><label asp-for="Registration.AcceptTerms" class="form-check-label">By signing up you agree to our <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.</label></div>
            <button class="btn btn-primary" type="submit">Submit</button>
        </form>
        <form id="login-panel" method="post" asp-page-handler="Login" class="@(Model.ActiveTab == "login" ? "" : "d-none")">
            <div class="form-group"><label asp-for="Credentials.UserName">Username</label><input asp-for="Credentials.UserName" class="form-control" autocomplete="username" /></div>
            <div class="form-group"><label asp-for="Credentials.Password">Password</label><input asp-for="Credentials.Password" class="form-control" autocomplete="current-password" /></div>
            <button class="btn btn-primary" type="submit">Log In</button><a class="forgot-password-link" asp-page="/ForgotPassword">Forgot password?</a>
        </form>
    </section>
</div>
@section Scripts {
<script>
    document.querySelectorAll('[data-auth-tab]').forEach(button => button.addEventListener('click', () => {
        const register = button.dataset.authTab === 'register';
        document.getElementById('register-panel').classList.toggle('d-none', !register);
        document.getElementById('login-panel').classList.toggle('d-none', register);
        document.querySelectorAll('[data-auth-tab]').forEach(tab => tab.classList.toggle('active', tab === button));
    }));
</script>
}
