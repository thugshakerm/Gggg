@page
@model Thugbium.Web.Pages.IndexModel
@{ ViewData["Title"] = "Main"; }
<div class="shrimp-landing">
    <section class="shrimp-intro">
        <div class="shrimp-brand"><img src="~/images/shrimp-logo.png" alt="Shrimp logo" /><h1>HRIMP</h1></div>
    </section>
    <section class="shrimp-auth-card" aria-label="Account access">
        <h2>SIGN UP OR LOGIN AND START HAVING FUN!</h2>
        <div class="shrimp-tabs"><button type="button" class="active" data-auth-tab="register">Register</button><button type="button" data-auth-tab="login">Login</button></div>
        <form id="register-panel" method="post" asp-page="/Account/Register">
            <div class="form-group"><label for="landing-username">Username</label><input id="landing-username" class="form-control" name="Input.UserName" autocomplete="username" required /></div>
            <div class="form-group"><label for="landing-password">Password</label><input id="landing-password" class="form-control" type="password" name="Input.Password" autocomplete="new-password" required /></div>
            <div class="form-group"><label for="landing-confirm">Confirm Password</label><input id="landing-confirm" class="form-control" type="password" name="Input.ConfirmPassword" autocomplete="new-password" required /></div>
            <div class="form-group form-check"><input id="landing-terms" class="form-check-input" type="checkbox" name="Input.AcceptTerms" value="true" required /><label class="form-check-label" for="landing-terms">By signing up you agree to our <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.</label></div>
            <button class="btn btn-primary" type="submit">Submit</button>
        </form>
        <form id="login-panel" class="d-none" method="post" asp-page="/Account/Login">
            <div class="form-group"><label for="landing-login-username">Username</label><input id="landing-login-username" class="form-control" name="Input.UserName" autocomplete="username" required /></div>
            <div class="form-group"><label for="landing-login-password">Password</label><input id="landing-login-password" class="form-control" type="password" name="Input.Password" autocomplete="current-password" required /></div>
            <button class="btn btn-primary" type="submit">Log In</button>
        </form>
    </section>
</div>
@section Scripts {
<script>
    document.querySelectorAll('[data-auth-tab]').forEach(button => button.addEventListener('click', () => {
        const register = button.dataset.authTab === 'register';
        document.getElementById('register-panel').classList.toggle('d-none', !register);
        document.getElementById('login-panel').classList.toggle('d-none', register);
        document.querySelectorAll('[data-auth-tab]').forEach(tab => tab.classList.toggle('active', tab === button));
    }));
</script>
}
