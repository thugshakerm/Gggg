@page "{id:long}"
@model Thugbium.Web.Pages.Places.DetailsModel
@{ ViewData["Title"] = Model.Place?.Name ?? "Place"; }
<div class="container page-wrap place-details">@if (Model.Place is null) { <div class="alert alert-warning">This place does not exist or is private.</div> } else { <div class="dark-card"><div class="place-details-thumb"></div><div class="p-4"><div class="d-sm-flex justify-content-between align-items-start"><div><h1 class="h3 font-weight-bold mb-1">@Model.Place.Name</h1><p class="text-muted mb-3">By <a asp-page="/Users/Profile" asp-route-username="@Model.Place.Owner.UserName">@Model.Place.Owner.UserName</a></p></div><button class="btn btn-primary" disabled>Play</button></div><ul class="nav nav-tabs place-tabs"><li class="nav-item"><a class="nav-link active" href="#about">About</a></li></ul><section id="about" class="pt-3"><p>@(string.IsNullOrWhiteSpace(Model.Place.Description) ? "No description has been added." : Model.Place.Description)</p><p class="text-muted mb-0">This place is not playable yet. Client support is coming later.</p></section></div></div> }</div>
