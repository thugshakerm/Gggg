@page
@model Thugbium.Web.Pages.Places.IndexModel
@{ ViewData["Title"] = "Places"; }
<div class="container page-wrap places-page"><div class="home-section-header"><h1 class="h3 font-weight-bold">Games</h1>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary" asp-page="/Create">Create</a> }</div><div class="dark-card p-3"><div class="input-group mb-3"><input class="form-control" placeholder="Search games" disabled /><div class="input-group-append"><button class="btn btn-primary" disabled>Search</button></div></div>@if (Model.Places.Count == 0) { <div class="empty-state">No public places have been published yet.</div> } else { <div class="row">@foreach (var place in Model.Places) { <div class="col-sm-6 col-lg-4 mb-3"><a class="dark-card place-card" asp-page="/Places/Details" asp-route-id="@place.Id"><div class="place-thumb"></div><div class="p-3"><h2 class="h6 mb-1">@place.Name</h2><p class="text-muted small mb-0">By @place.Owner.UserName</p></div></a></div> }</div> }</div></div>
