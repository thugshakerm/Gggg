@page "{username}"
@model Thugbium.Web.Pages.Users.ProfileModel
@{ ViewData["Title"] = Model.Profile?.UserName ?? "User"; }
<div class="container page-wrap">@if (Model.Profile is null) { <div class="alert alert-warning">That user does not exist.</div> } else { <div class="card dark-card"><div class="card-body p-4"><h1 class="h3 font-weight-bold">@Model.Profile.UserName</h1><p class="text-muted">Joined @Model.Profile.CreatedAt.UtcDateTime.ToString("MMMM yyyy")</p><p>Discord: @(Model.Profile.IsDiscordVerified ? "Verified" : "Not verified")</p></div></div> }</div>
