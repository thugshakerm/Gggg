@page "/users/{userId:guid}/profile"
@model Thugbium.Web.Pages.Users.ProfileModel
@{ ViewData["Title"] = Model.Profile?.UserName ?? "User"; }
<div class="container page-wrap profile-page">
    @if (Model.Profile is null)
    {
        <div class="alert alert-warning">That user does not exist.</div>
    }
    else
    {
        <section class="card dark-card profile-header-card">
            <div class="card-body profile-header-content">
                <div class="profile-avatar-wrap"><div class="profile-avatar-empty"></div><span class="avatar-status icon-online" title="Online"></span></div>
                <div class="profile-caption"><h1>@Model.Profile.UserName</h1><div class="profile-details"><span>0 Friends</span><span>0 Followers</span><span>0 Following</span></div><p class="text-muted mb-0">@(Model.Profile.IsDiscordVerified ? "Discord verified" : "Not verified")</p></div>
            </div>
        </section>
        <ul class="nav nav-tabs profile-tabs" role="tablist"><li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#about" role="tab">About</a></li><li class="nav-item"><a class="nav-link" data-toggle="tab" href="#creations" role="tab">Creations</a></li></ul>
        <div class="tab-content profile-tab-content">
            <div class="tab-pane active" id="about" role="tabpanel"><section class="card dark-card"><div class="card-header"><h2 class="h5 mb-0">About</h2></div><div class="card-body"><p class="text-muted mb-4">This user has not written anything here yet.</p><div class="profile-statistics"><div><span>Join Date</span><strong>@Model.Profile.CreatedAt.UtcDateTime.ToString("M/d/yyyy")</strong></div><div><span>Place Visits</span><strong>0</strong></div><div><span>Forum Posts</span><strong>0</strong></div></div></div></section></div>
            <div class="tab-pane" id="creations" role="tabpanel"><section class="card dark-card"><div class="card-header"><h2 class="h5 mb-0">Games</h2></div><div class="card-body"><div class="empty-state">No creations to show.</div></div></section></div>
        </div>
    }
</div>
