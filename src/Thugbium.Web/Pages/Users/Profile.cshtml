@page "/users/{userId:long}/profile"
@model Thugbium.Web.Pages.Users.ProfileModel
@{ ViewData["Title"] = Model.Profile?.UserName ?? "User"; }
<div class="container page-wrap profile-page">
@if (Model.Profile is null)
{
    <div class="alert alert-warning">That user does not exist.</div>
}
else
{
    <section class="profile-container">
        <div class="card dark-card profile-header">
            <div class="card-body profile-header-content">
                <div class="profile-header-top">
                    <div class="profile-avatar-image"><div class="profile-avatar-empty rcc-render-placeholder"></div><span class="avatar-status online icon-online" title="Online"></span></div>
                    <div class="header-caption"><div class="header-title"><h2>@Model.Profile.UserName</h2></div><ul class="details-info"><li>0 Friends</li><li>0 Followers</li><li>0 Following</li></ul></div>
                </div>
            </div>
        </div>
        <div class="rbx-tabs-horizontal">
            <ul class="nav nav-tabs profile-tabs" role="tablist"><li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#about" role="tab">About</a></li><li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#creations" role="tab">Creations</a></li></ul>
            <div class="tab-content profile-tab-content">
                <div class="tab-pane active" id="about" role="tabpanel">
                    <section class="card dark-card profile-about mb-3"><div class="card-header"><h3 class="h5 mb-0">About</h3></div><div class="card-body"><div class="profile-about-content"><p class="mb-0 text-muted">This user has not written anything here yet.</p></div></div></section>
                    <section class="card dark-card profile-avatar mb-3"><div class="card-header"><h3 class="h5 mb-0">Currently Wearing</h3></div><div class="card-body"><div class="row"><div class="col-md-6 mb-3 mb-md-0"><div class="fullbody-render rcc-render-placeholder" data-user="@Model.Profile.ProfileId" aria-label="Avatar render loading"><span class="fullbody-render-mode">3D</span></div></div><div class="col-md-6"><div class="wearing-items"><div class="wearing-empty">No worn items to show.</div></div></div></div></div></section>
                    <section class="card dark-card profile-statistics"><div class="card-header"><h3 class="h5 mb-0">Statistics</h3></div><div class="card-body"><ul class="profile-stats-container"><li class="profile-stat"><span>Join Date</span><strong>@Model.Profile.CreatedAt.UtcDateTime.ToString("M/d/yyyy")</strong></li><li class="profile-stat"><span>Place Visits</span><strong>0</strong></li></ul></div></section>
                </div>
                <div class="tab-pane" id="creations" role="tabpanel"><section class="card dark-card profile-game"><div class="card-header"><h3 class="h5 mb-0">Games</h3></div><div class="card-body"><div class="empty-state">No creations to show.</div></div></section></div>
            </div>
        </div>
    </section>
}
</div>
